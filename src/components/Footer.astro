---
/* Fixed copyright bar, verbatim text and styling:
   "ⓒ 2024 - 2026", bold uppercase 10px, letter-spacing 0.8px. */
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copyright">ⓒ 2024 - 2026</p>
  </div>
</footer>

<style>
  .site-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--white);
    border-top: 1px solid var(--grey-footer-line);
    z-index: 2;
  }
  .site-footer__inner {
    padding: var(--space-4) var(--space-5);
  }
  .site-footer__copyright {
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-footer);
    text-transform: uppercase;
    letter-spacing: var(--ls-footer);
    color: var(--black);
  }

  @media (max-width: 600px) {
    .site-footer__inner { padding: var(--space-3) var(--space-4); }
  }
</style>
