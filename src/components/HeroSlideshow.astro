---
/* Full-viewport background slideshow — 3 frames, plain CSS cross-fade.
   Reference: swiper "fadeslides" carousel (jQuery + Swiper JS,
   home-slideshow, data-autoplay="true") over the same 3 images, each
   with a dark scrim and a centred caption "HONG KONG | BALI |
   SWITZERLAND". Reproduced here with pure CSS keyframe opacity —
   no JS shipped for a slideshow that does nothing interactive
   (Yulia's "static unless interaction earns its keep").
   Timing (6s dwell / 2s cross-fade) is a reasonable match for the
   ambient pace of the original; Swiper's exact autoplay delay is set
   by JavaScript not present in this static markup, so this is a
   considered approximation, not a measured value. */
import { getImage } from 'astro:assets';
import hongkong from '../assets/hero-hongkong.jpg';
import bali from '../assets/hero-bali.jpg';
import zermatt from '../assets/hero-zermatt.jpg';

/* Decorative ambient background — the meaningful content is the
   visible caption text below, not the imagery, so the slides carry
   empty alt and the wrapper is hidden from assistive tech. */
const slides = [
  { src: hongkong },
  { src: bali },
  { src: zermatt },
];

const images = await Promise.all(
  slides.map((s) =>
    getImage({
      src: s.src,
      widths: [768, 1280, 1920, 2560],
      sizes: '100vw',
      format: 'webp',
      quality: 78,
    }),
  ),
);
---

<div class="hero-slideshow">
  <div class="hero-slideshow__frames" aria-hidden="true">
    {
      images.map((img, i) => (
        <div class={`hero-slideshow__slide hero-slideshow__slide--${i + 1}`}>
          <img
            class="hero-slideshow__img"
            src={img.src}
            srcset={img.srcSet.attribute}
            sizes="100vw"
            alt=""
            width={img.attributes.width}
            height={img.attributes.height}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        </div>
      ))
    }
  </div>
  <div class="hero-slideshow__scrim" aria-hidden="true"></div>
  <p class="hero-slideshow__caption">HONG KONG | BALI | SWITZERLAND</p>
</div>

<style define:vars={{ slideCount: slides.length }}>
  .hero-slideshow {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: var(--black);
  }

  .hero-slideshow__frames {
    position: absolute;
    inset: 0;
  }

  .hero-slideshow__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: hero-cross-fade calc(var(--slideCount) * 6s) linear infinite;
  }
  /* True crossfade, not a sequential blackout. Each slide's fall (from
     1 to 0, local 6s-8s) is timed to land on exactly the same 2s
     window, in real time, as the next slide's rise (from 0 to 1,
     local 0s-2s) — because the next slide's slot starts the instant
     this one's ends, and delays are multiples of the 6s slot. Since
     both ramps are linear and complementary over that shared window,
     their opacities sum to 1 throughout: outgoing + incoming = 1, not
     a dip through 0. Only one slide is at full opacity outside the
     2s overlap windows, so no more than two slides ever overlap. */
  .hero-slideshow__slide--1 { animation-delay: 0s; }
  .hero-slideshow__slide--2 { animation-delay: -12s; }
  .hero-slideshow__slide--3 { animation-delay: -6s; }

  /* Local timeline per slide (18s cycle): rise 0s-2s, hold 2s-6s,
     fall 6s-8s (into the next slide's slot), off 8s-18s. */
  @keyframes hero-cross-fade {
    0%      { opacity: 0; }
    11.111% { opacity: 1; }
    33.333% { opacity: 1; }
    44.444% { opacity: 0; }
    100%    { opacity: 0; }
  }

  .hero-slideshow__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Reference (.brxy-heading-wrap) dims the whole hero, not a box
     around the text — a full-viewport 15% black scrim above the
     slides, below the caption. */
  .hero-slideshow__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.15);
  }

  .hero-slideshow__caption {
    margin: 0;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    color: var(--white);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-caption);
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    padding: var(--space-2) var(--space-5);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slideshow__slide { animation: none; opacity: 0; }
    .hero-slideshow__slide--1 { opacity: 1; }
  }

  @media (max-width: 600px) {
    .hero-slideshow__caption {
      font-size: 11px;
      white-space: normal;
      width: 80%;
    }
  }
</style>
