---
/* Base layout — shared shell for the (currently single) page.
   Wires design tokens + base CSS, meta/OG tags, and the skip link.
   Trimmed to what this splash page actually needs — no age gate, no
   terms modal, no sticky-contact, none of which exist on the reference. */
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Data & Media | Blockchain | Consumer Marketing',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// public/ assets are copied verbatim to the site root. Served at the
// domain root (base '/'), so an absolute path resolves correctly.
const iconHref = '/favicon.png';
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <link rel="icon" type="image/png" href={iconHref} />
    <link rel="apple-touch-icon" sizes="57x57" href={iconHref} />
    <link rel="apple-touch-icon" sizes="72x72" href={iconHref} />
    <link rel="apple-touch-icon" sizes="114x114" href={iconHref} />
    <link rel="apple-touch-icon" sizes="144x144" href={iconHref} />
    <meta name="msapplication-TileImage" content={iconHref} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="ZΞD|CAPITAL" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
